# v2.4: سوبر ماركت بن دول. Copy to .env and fill locally; no real credentials here.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://bin_doul_app:CHANGE_ME@127.0.0.1:5432/bin_doul
IDEMPOTENCY_SECRET=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
SESSION_HOURS=8
DEFAULT_TIMEZONE=Asia/Aden

# Optional. Set a random 32+ character token before enabling n8n.
N8N_API_TOKEN=
# Empty disables delivery channels. Supported: email or email,whatsapp
NOTIFICATION_CHANNELS=

# Optional local PostgreSQL container. Choose a strong local password.
POSTGRES_DB=bin_doul
POSTGRES_USER=bin_doul_owner
POSTGRES_PASSWORD=
