# Copy to .env in this directory. No passwords are shipped.
APP_ENV=production
# SQL authentication: URL-encode username/password, e.g. @ becomes %40.
DATABASE_URL=mssql+pyodbc://USER:PASSWORD@localhost:1433/DailySales?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
IDEMPOTENCY_SECRET=
# Windows authentication alternative (local development only, local certificate):
# Named instance, Windows authentication (use actual instance and database names):
# DATABASE_URL=mssql+pyodbc://@localhost%5CSQLEXPRESS/DailySales?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
COOKIE_SECURE=true
# For HTTP on localhost only: APP_ENV=development and COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SESSION_HOURS=8
DEFAULT_TIMEZONE=Asia/Riyadh
DEFAULT_CURRENCY=SAR
