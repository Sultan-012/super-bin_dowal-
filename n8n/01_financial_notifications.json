    {
      "id": "has-a-delivery",
      "name": "Has a delivery",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Has a delivery-condition",
              "leftValue": "={{ $json.delivery ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "prepare-message",
      "name": "Prepare message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const d=$input.first().json.delivery;\nconst p=d.payload;\nconst format=v=>{const [whole,fraction='']=String(v).split('.');return whole.replace(/\\B(?=(\\d{3})+(?!\\d))/g,',')+'.'+fraction.padEnd(2,'0');};\nlet subject='',text='';\nif(d.kind==='off_device_sales'){\n subject='أصناف خارج الجهاز | '+p.store+' | '+p.business_date;\n text='الموظف: '+p.employee+'\\nتاريخ الصندوق: '+p.business_date+'\\n'+p.items.map(i=>i.name+' | رقم '+i.item_code+' | عدد '+i.quantity+' | قيمة '+format(i.amount)+' ريال يمني').join('\\n');\n}else if(d.kind==='cash_shortage'){\n subject='عجز معتمد في الوردية #'+p.shift_id+' | '+p.store;\n text='الموظف: '+p.employee+'\\nتاريخ الصندوق: '+p.business_date+'\\nالعجز: '+format(p.shortage)+' ريال يمني\\nالنقد المتوقع: '+format(p.expected_cash)+'\\nالنقد الموثق: '+format(p.actual_cash)+'\\nملاحظة الاعتماد: '+p.note;\n}else{\n subject='التقرير الشهري | '+p.employee+' | '+p.month;\n text='تقرير مستقل للموظف '+p.employee+' عن شهر '+p.month+' بحسب تاريخ الصندوق في جهاز المحاسبة.\\nالمرفق لقطة محفوظة من قاعدة البيانات وقت تجهيز التقرير.';\n}\nreturn [{json:{delivery:d,subject,text,whatsapp_summary:(subject+' — '+text.replace(/\\n/g,' | ')).slice(0,1000)}}];"
      }
    },
    {
      "id": "email-channel",
      "name": "Email channel",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
